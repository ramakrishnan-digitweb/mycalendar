# Copy to .env (deployed config) — non-secret values only.
# Secrets (GOOGLE_CLIENT_SECRET, RESEND_API_KEY) are set with:
#   firebase functions:secrets:set GOOGLE_CLIENT_SECRET
#   firebase functions:secrets:set RESEND_API_KEY
# For the local emulator put them in functions/.secret.local instead.

# The Google account that owns this scheduler (only it can open /admin)
HOST_EMAIL=you@example.com
# Public URL of the site (no trailing slash). Use http://localhost:5173 in .env.local for dev.
APP_URL=https://your-project-id.web.app
# Verified Resend sender
EMAIL_FROM="Your Name <meet@yourdomain.com>"
# OAuth client (type "Web application") from Google Cloud Console
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
